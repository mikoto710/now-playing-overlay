<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>NowPlayingOverlay</AssemblyName>
    <AssemblyTitle>Now Playing Overlay</AssemblyTitle>
    <Product>Now Playing Overlay</Product>
    <Description>Local Spotify now-playing overlay host for OBS.</Description>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>NowPlayingOverlay.Host</RootNamespace>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <ApplicationIcon>Assets\NowPlayingOverlay.ico</ApplicationIcon>
    <WebAssetPath>$(MSBuildProjectDirectory)\..\web\dist\NowPlaying.html</WebAssetPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Remove="System.Windows.Forms" />
    <ProjectReference Include="..\host.winrt\NowPlayingOverlay.WinRT.csproj" />
    <InternalsVisibleTo Include="NowPlayingOverlay.Host.Tests" />
    <EmbeddedResource Include="Assets\NowPlayingOverlay.ico" LogicalName="NowPlayingOverlay.Assets.NowPlayingOverlay.ico" />
    <EmbeddedResource Include="$(WebAssetPath)" LogicalName="NowPlayingOverlay.Web.NowPlaying.html" />
  </ItemGroup>

  <Target Name="PrepareEmbeddedWebAsset" BeforeTargets="PrepareResourceNames">
    <Error
      Condition="!Exists('$(WebAssetPath)')"
      Text="The production web asset is missing at '$(WebAssetPath)'. Run 'npm --prefix web run build' before building the host." />
  </Target>

</Project>
